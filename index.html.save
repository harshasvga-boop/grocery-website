      <div class="bg-white dark:bg-slate-800 p-2.5 rounded-2xl text-slate-800 dark:text-slate-200 shadow-sm border border-slate-100 dark:border-slate-700">
        வணக்கம் அண்ணா! நான் சாரல். "Sugar stock evlo?", "யார் கடன் வைத்திருக்கிறார்கள்?", "இன்றைய விற்பனை எவ்வளவு?" என்று கேளுங்கள்!
      </div>
    </div>

    <!-- Quick Query Chips -->
    <div class="p-2 bg-slate-100 dark:bg-slate-800 border-t border-b dark:border-slate-700 flex gap-1.5 overflow-x-auto text-[10px]">
      <button onclick="askAIChat('Sugar stock evlo irukku?')" class="bg-white dark:bg-slate-700 border rounded-full px-2.5 py-1 shrink-0 font-bold">🍬 Sugar Stock?</button>
      <button onclick="askAIChat('Who owes me money?')" class="bg-white dark:bg-slate-700 border rounded-full px-2.5 py-1 shrink-0 font-bold">📖 Debtors?</button>
      <button onclick="askAIChat('Today sales report')" class="bg-white dark:bg-slate-700 border rounded-full px-2.5 py-1 shrink-0 font-bold">📊 Sales Report</button>
    </div>

    <!-- Input Box -->
    <div class="p-2 bg-white dark:bg-slate-800 flex gap-2 items-center">
