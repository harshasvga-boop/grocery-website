    <div class="bg-tea text-white p-3 font-bold flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="text-xl">✨</span>
        <div>
          <p class="text-xs font-extrabold">சாரல் AI (Saaral Voice Assistant)</p>
          <p class="text-[10px] text-tea-light">Saravanan Store Assistant</p>
        </div>
