      <input type="text" id="ai-chat-input" placeholder="கேளுங்கள் / Type question..." class="flex-1 border rounded-full px-3 py-1.5 text-xs dark:bg-slate-700 dark:text-white dark:border-slate-600 focus:outline-none" onkeydown="if(event.key==='Enter') sendAIChatMessage()" />
      <button onclick="sendAIChatMessage()" class="bg-tea text-white p-2 rounded-full font-bold text-xs">➔</button>
    </div>
  </div>

  <button onclick="toggleAIChat()" class="fixed bottom-20 right-4 bg-tea hover:bg-tea-dark text-white p-3.5 rounded-full shadow-2xl z-40 active:scale-95 transition-transform flex items-center gap-1.5 border-2 border-white">
