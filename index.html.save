  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Saravanan Professional Grocery Store – Smart Shop Manager</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Noto Sans Tamil -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- QRCode.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  
  <!-- Canvas Confetti CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/canvas-confetti/1.6.0/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            tea: { light: '#E6CCB2', DEFAULT: '#8D5B4C', dark: '#5C3A2E' },
            leaf: { DEFAULT: '#2E7D32', dark: '#1B5E20', light: '#A5D6A7' },
            turmeric: { DEFAULT: '#F59E0B', light: '#FEF3C7', dark: '#B45309' },
            cream: '#FFFBEB'
          },
          fontFamily: {
            sans: ['"Noto Sans Tamil"', 'system-ui', '-apple-system', 'sans-serif']
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Safe Area and Micro-animations */
    body {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      padding-bottom: env(safe-area-inset-bottom);
    }
    .safe-top { padding-top: max(0.75rem, env(safe-area-inset-top)); }
    .safe-bottom { padding-bottom: max(1rem, env(safe-area-inset-bottom)); }
    
    .touch-target { min-height: 48px; min-width: 48px; }
    
    @keyframes bell-ring {
      0%, 100% { transform: rotate(0deg); }
      20%, 60% { transform: rotate(15deg); }
      40%, 80% { transform: rotate(-15deg); }
    }
    .animate-ring { animation: bell-ring 0.8s ease-in-out infinite; }
    
    @keyframes heart-pop {
      0% { transform: scale(1); }
      50% { transform: scale(1.35); }
      100% { transform: scale(1); }
    }
    .animate-pop { animation: heart-pop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275); }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body class="h-full bg-cream dark:bg-slate-900 text-slate-800 dark:text-slate-100 flex flex-col font-sans transition-colors duration-200">

  <!-- TOP APP HEADER -->
  <header class="bg-tea text-white safe-top px-3 py-2.5 shadow-md sticky top-0 z-30">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-2">
      <!-- Shop Title & Contacts -->
      <div class="flex items-center gap-2 overflow-hidden">
        <span class="text-2xl">☕</span>
        <div class="truncate">
          <h1 class="font-extrabold text-sm md:text-base leading-tight truncate">சரவணன் புரோஃபெஷனல் மளிகை கடை</h1>
          <p class="text-[11px] text-tea-light flex items-center gap-1.5 truncate">
            <span>SARAVANAN S P</span>
            <span>•</span>
            <a href="tel:9842771765" target="_blank" onclick="handleCallClick('9842771765')" class="underline hover:text-white">9842771765</a>
          </p>
        </div>
      </div>

      <!-- Action Icons & Toggles -->
      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Direct Call Shortcuts -->
        <a href="tel:9842771765" target="_blank" onclick="handleCallClick('9842771765')" class="p-2 bg-leaf hover:bg-leaf-dark text-white rounded-full touch-target flex items-center justify-center shadow text-sm" title="Call Saravanan">📞</a>
        
        <!-- Alert Bell -->
        <button onclick="openAlertsModal()" class="relative p-2 bg-tea-dark/60 rounded-full touch-target flex items-center justify-center text-lg" title="Notifications">
          🔔
          <span id="alert-badge" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-tea animate-ring">0</span>
        </button>

        <!-- Dark Mode Toggle -->
        <button onclick="toggleDarkMode()" class="p-2 bg-tea-dark/60 rounded-full touch-target flex items-center justify-center text-sm" title="Toggle Theme">
          <span id="theme-icon">🌙</span>
        </button>

        <!-- Language Toggle -->
        <button onclick="toggleLanguage()" class="bg-turmeric text-amber-950 font-bold px-2.5 py-1.5 rounded-xl text-xs border border-amber-600 shadow touch-target flex items-center justify-center">
          <span id="lang-toggle-text">EN</span>
        </button>
      </div>
    </div>

    <!-- GLOBAL SMART SEARCH BAR -->
    <div class="max-w-4xl mx-auto mt-2 relative">
      <div class="relative flex items-center">
        <input type="text" id="global-search" oninput="handleGlobalSearch()" placeholder="தேடவும் (அரிசி, Sugar, Milk, முருகன்...)" class="w-full pl-9 pr-10 py-2 text-xs md:text-sm text-slate-900 rounded-xl bg-white/95 dark:bg-slate-800 dark:text-white border border-tea-light/50 focus:outline-none focus:ring-2 focus:ring-leaf shadow-inner" />
        <span class="absolute left-3 text-slate-400 text-xs">🔍</span>
        <button onclick="startVoiceSearch('search')" class="absolute right-1.5 p-1.5 text-tea hover:text-leaf dark:text-tea-light rounded-lg touch-target flex items-center justify-center" title="Voice Search">
          🎙️
        </button>
      </div>
      <!-- Dropdown Results -->
      <div id="search-results-dropdown" class="hidden absolute left-0 right-0 top-full mt-1 bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 max-h-72 overflow-y-auto z-50 p-2 space-y-1"></div>
    </div>
  </header>

  <!-- MAIN CONTENT CONTAINER (5 SCREEN TABS) -->
  <main class="flex-1 max-w-4xl w-full mx-auto p-3 md:p-4 overflow-y-auto pb-24">
    
    <!-- 1. HOME SCREEN -->
    <section id="tab-home" class="space-y-4">
      <!-- Greeting Header -->
      <div class="bg-gradient-to-r from-tea to-tea-dark text-white p-4 rounded-3xl shadow-md flex justify-between items-center">
        <div>
          <p class="text-xs text-tea-light font-medium" id="greeting-time">வணக்கம் அண்ணா</p>
          <h2 class="text-xl font-extrabold" id="greeting-title">Vanakkam Anna! 🙏</h2>
          <p class="text-xs text-amber-200 mt-1" data-i18n="homeSub">இன்றைய கடை செயல்பாடு விவரங்கள்</p>
        </div>
        <div class="text-4xl">🏪</div>
      </div>

      <!-- Key Business Dashboard Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <!-- Today Sales -->
        <div onclick="switchTab('bill')" class="bg-white dark:bg-slate-800 p-3.5 rounded-2xl shadow-sm border-l-4 border-emerald-500 cursor-pointer active:scale-95 transition-transform">
          <p class="text-[11px] text-slate-500 dark:text-slate-400 font-bold" data-i18n="todaySales">இன்றைய விற்பனை</p>
          <p class="text-lg md:text-xl font-black text-slate-800 dark:text-white mt-0.5" id="dash-sales">₹0.00</p>
        </div>

        <!-- Estimated Profit -->
        <div class="bg-white dark:bg-slate-800 p-3.5 rounded-2xl shadow-sm border-l-4 border-leaf">
          <p class="text-[11px] text-slate-500 dark:text-slate-400 font-bold" data-i18n="todayProfit">மதிப்பிடப்பட்ட லாபம்</p>
          <p class="text-lg md:text-xl font-black text-leaf mt-0.5" id="dash-profit">₹0.00</p>
        </div>

        <!-- Credit Due -->
        <div onclick="switchTab('credit')" class="bg-white dark:bg-slate-800 p-3.5 rounded-2xl shadow-sm border-l-4 border-red-500 cursor-pointer active:scale-95 transition-transform">
          <p class="text-[11px] text-slate-500 dark:text-slate-400 font-bold" data-i18n="creditDue">மொத்த கடன் நிலுவை</p>
          <p class="text-lg md:text-xl font-black text-red-600 dark:text-red-400 mt-0.5" id="dash-credit">₹0.00</p>
        </div>

        <!-- Low Stock Count -->
        <div onclick="switchTab('stock')" class="bg-white dark:bg-slate-800 p-3.5 rounded-2xl shadow-sm border-l-4 border-amber-500 cursor-pointer active:scale-95 transition-transform">
          <p class="text-[11px] text-slate-500 dark:text-slate-400 font-bold" data-i18n="lowStockCount">இருப்பு குறைவு</p>
          <p class="text-lg md:text-xl font-black text-amber-600 dark:text-amber-400 mt-0.5" id="dash-low-stock">0 Items</p>
        </div>

        <!-- Expiring Soon Count -->
        <div onclick="switchTab('stock')" class="bg-white dark:bg-slate-800 p-3.5 rounded-2xl shadow-sm border-l-4 border-orange-500 cursor-pointer active:scale-95 transition-transform">
          <p class="text-[11px] text-slate-500 dark:text-slate-400 font-bold" data-i18n="expiringCount">காலாவதி விரைவில்</p>
          <p class="text-lg md:text-xl font-black text-orange-600 dark:text-orange-400 mt-0.5" id="dash-expiring">0 Items</p>
        </div>

        <!-- Tea Cups Sold -->
        <div onclick="switchTab('more')" class="bg-white dark:bg-slate-800 p-3.5 rounded-2xl shadow-sm border-l-4 border-tea cursor-pointer active:scale-95 transition-transform">
          <p class="text-[11px] text-slate-500 dark:text-slate-400 font-bold" data-i18n="teaCupsSold">டீ விற்ற எண்ணிக்கை</p>
          <p class="text-lg md:text-xl font-black text-tea-dark dark:text-tea-light mt-0.5" id="dash-tea-cups">0 Cups</p>
        </div>
      </div>

      <!-- Quick Alert Summary Card -->
      <div class="bg-white dark:bg-slate-800 p-4 rounded-3xl shadow-sm border border-orange-100 dark:border-slate-700">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
          <span data-i18n="quickAlerts">முக்கிய எச்சரிக்கைகள்</span>
          <span id="alerts-count-tag" class="text-[10px] bg-red-100 text-red-700 font-extrabold px-2 py-0.5 rounded-full">0 Active</span>
        </h3>
        <div id="home-alerts-list" class="space-y-2 text-xs">
          <!-- Populated dynamically -->
        </div>
      </div>
    </section>

    <!-- 2. BILL / POS SCREEN -->
    <section id="tab-bill" class="hidden space-y-4">
      <!-- Categories & Filter Chips -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
        <button onclick="filterBillCategory('all')" id="cat-all" class="px-3 py-2 rounded-xl font-bold bg-tea text-white shadow shrink-0 touch-target">
          🛍️ <span data-i18n="catAll">அனைத்தும்</span>
        </button>
        <button onclick="filterBillCategory('fav')" id="cat-fav" class="px-3 py-2 rounded-xl font-bold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border shrink-0 touch-target">
          ❤️ <span data-i18n="catFav">விருப்பமானவை</span>
        </button>
        <button onclick="filterBillCategory('grocery')" id="cat-grocery" class="px-3 py-2 rounded-xl font-bold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border shrink-0 touch-target">
          🌾 <span data-i18n="catGrocery">மளிகை</span>
        </button>
        <button onclick="filterBillCategory('tea')" id="cat-tea" class="px-3 py-2 rounded-xl font-bold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border shrink-0 touch-target">
          ☕ <span data-i18n="catTea">டீ & ஸ்நாக்ஸ்</span>
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
        <!-- Product Tiles Grid -->
        <div class="lg:col-span-7 bg-white dark:bg-slate-800 p-3 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700">
          <div id="bill-product-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-h-[460px] overflow-y-auto pr-1">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Cart & Checkout Side Panel -->
        <div class="lg:col-span-5 bg-white dark:bg-slate-800 p-4 rounded-3xl shadow-md border-2 border-tea flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center border-b border-slate-100 dark:border-slate-700 pb-2 mb-2">
              <h3 class="font-extrabold text-sm text-tea-dark dark:text-tea-light flex items-center gap-1.5">
                🛒 <span data-i18n="currentCart">தற்போதைய கார்ட்</span>
              </h3>
              <button onclick="clearCart()" class="text-[11px] text-red-500 hover:underline font-bold touch-target">Clear</button>
            </div>

            <!-- Customer Picker for Credit/Udhaar -->
            <div class="mb-3">
              <label class="block text-[10px] font-bold text-slate-400 mb-1" data-i18n="selectCustomer">வாடிக்கையாளர் (கடன் என்றால் மட்டும்):</label>
              <select id="bill-customer-select" class="w-full text-xs p-2 rounded-xl border border-slate-200 dark:bg-slate-700 dark:text-white dark:border-slate-600 focus:outline-none">
                <option value="">-- ரொக்கம் / Cash Sale --</option>
                <!-- Populated dynamically -->
              </select>
            </div>

            <!-- Cart Items Scroll -->
            <div id="cart-items-list" class="space-y-2 max-h-48 overflow-y-auto pr-1 mb-3 text-xs">
              <!-- Cart Items Populated -->
            </div>
          </div>

          <!-- Totals & Payment Buttons -->
          <div class="border-t border-slate-100 dark:border-slate-700 pt-3 space-y-2 bg-cream/50 dark:bg-slate-900/50 p-3 rounded-2xl">
            <div class="flex justify-between text-sm font-extrabold">
              <span data-i18n="total">மொத்த தொகை:</span>
              <span id="cart-total-amount" class="text-slate-900 dark:text-white text-base">₹0.00</span>
            </div>
            <div class="flex justify-between text-[11px] font-bold text-leaf">
              <span data-i18n="estProfit">லாபம் (Profit):</span>
              <span id="cart-total-profit">₹0.00</span>
            </div>

            <!-- Payment Options -->
            <div class="grid grid-cols-3 gap-1.5 pt-1">
              <button onclick="handleCheckout('CASH')" class="bg-leaf hover:bg-leaf-dark text-white font-extrabold py-3 rounded-xl shadow active:scale-95 transition-transform touch-target flex flex-col items-center justify-center">
                <span class="text-[10px] opacity-90" data-i18n="cash">ரொக்கம்</span>
                <span class="text-xs">💵 CASH</span>
              </button>
              <button onclick="handleCheckout('UPI')" class="bg-blue-600 hover:bg-blue-700 text-white font-extrabold py-3 rounded-xl shadow active:scale-95 transition-transform touch-target flex flex-col items-center justify-center">
                <span class="text-[10px] opacity-90">ஜிபே / UPI</span>
                <span class="text-xs">📱 UPI</span>
              </button>
              <button onclick="handleCheckout('CREDIT')" class="bg-turmeric hover:bg-amber-500 text-amber-950 font-extrabold py-3 rounded-xl shadow active:scale-95 transition-transform touch-target flex flex-col items-center justify-center">
                <span class="text-[10px] opacity-90" data-i18n="credit">கடன்</span>
                <span class="text-xs">📖 UDHAAR</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. STOCK / INVENTORY SCREEN -->
    <section id="tab-stock" class="hidden space-y-4">
      <div class="flex justify-between items-center gap-2">
        <h2 class="font-extrabold text-base text-slate-800 dark:text-white" data-i18n="stockTitle">சரக்கு இருப்பு மேலாண்மை</h2>
        <button onclick="openProductModal()" class="bg-leaf hover:bg-leaf-dark text-white text-xs font-bold px-3 py-2 rounded-xl shadow touch-target flex items-center gap-1">
          <span>➕</span> <span data-i18n="addProduct">புதிய பொருள்</span>
        </button>
      </div>

      <!-- Stock List Table / Cards -->
      <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700 p-3">
        <div id="stock-items-list" class="space-y-3 max-h-[520px] overflow-y-auto pr-1">
          <!-- Populated dynamically -->
        </div>
      </div>
    </section>

    <!-- 4. CREDIT / UDHAAR LEDGER SCREEN -->
    <section id="tab-credit" class="hidden space-y-4">
      <div class="flex justify-between items-center gap-2">
        <div>
          <h2 class="font-extrabold text-base text-slate-800 dark:text-white" data-i18n="creditTitle">வாடிக்கையாளர் கடன் கணக்கு</h2>
          <p class="text-[11px] text-slate-400" id="total-credit-due-sub">மொத்த நிலுவை: ₹0.00</p>
        </div>
        <button onclick="openCustomerModal()" class="bg-tea hover:bg-tea-dark text-white text-xs font-bold px-3 py-2 rounded-xl shadow touch-target flex items-center gap-1">
          <span>👤➕</span> <span data-i18n="addCustomer">புதிய வாடிக்கையாளர்</span>
        </button>
      </div>

      <!-- Customer List -->
      <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700 p-3">
        <div id="customer-items-list" class="space-y-3 max-h-[520px] overflow-y-auto pr-1">
          <!-- Populated dynamically -->
        </div>
      </div>
    </section>

    <!-- 5. MORE SCREEN (Tea Counter, Expenses, Requests, Settings) -->
    <section id="tab-more" class="hidden space-y-4">
      <!-- Quick Tea / Coffee Counter Tracker -->
      <div class="bg-white dark:bg-slate-800 p-4 rounded-3xl shadow-sm border border-amber-200 dark:border-slate-700">
        <h3 class="font-extrabold text-sm text-amber-900 dark:text-amber-200 mb-2 flex items-center gap-2">
          <span>☕</span> <span data-i18n="teaCounterTitle">டீ கவுண்டர் & மூலப்பொருட்கள்</span>
        </h3>
        <div class="grid grid-cols-2 gap-2 mb-3">
          <button onclick="addTeaCounterCup('டீ / Tea', 12, 4)" class="bg-amber-50 dark:bg-slate-700 hover:bg-amber-100 border border-amber-300 p-3 rounded-2xl flex flex-col items-center active:scale-95 transition touch-target">
            <span class="text-2xl">☕</span>
            <span class="font-bold text-xs">டீ (Tea) ₹12</span>
          </button>
          <button onclick="addTeaCounterCup('காபி / Coffee', 15, 5)" class="bg-amber-50 dark:bg-slate-700 hover:bg-amber-100 border border-amber-300 p-3 rounded-2xl flex flex-col items-center active:scale-95 transition touch-target">
            <span class="text-2xl">☕</span>
            <span class="font-bold text-xs">காபி (Coffee) ₹15</span>
          </button>
        </div>
        <!-- Raw Ingredients Usage Today -->
        <div class="bg-amber-100/50 dark:bg-slate-900/50 p-2.5 rounded-xl text-[11px] grid grid-cols-3 gap-2 text-center">
          <div>🥛 பால்: <span id="tea-milk-used" class="font-bold text-amber-900 dark:text-amber-300">0 ml</span></div>
          <div>🍬 சர்க்கரை: <span id="tea-sugar-used" class="font-bold text-amber-900 dark:text-amber-300">0 g</span></div>
          <div>☕ டீ தூள்: <span id="tea-powder-used" class="font-bold text-amber-900 dark:text-amber-300">0 g</span></div>
        </div>
      </div>

      <!-- Expense Logger -->
      <div class="bg-white dark:bg-slate-800 p-4 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700">
        <h3 class="font-extrabold text-sm text-slate-800 dark:text-white mb-2 flex items-center justify-between">
          <span data-i18n="expenseTitle">💸 தினசரி செலவுகள்</span>
          <button onclick="openExpenseModal()" class="text-xs bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300 font-bold px-2.5 py-1 rounded-lg">➕ செலவு சேர்</button>
        </h3>
        <div id="expense-items-list" class="space-y-1.5 text-xs max-h-36 overflow-y-auto">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Customer Request List (Voice Enabled) -->
      <div class="bg-white dark:bg-slate-800 p-4 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700">
        <div class="flex justify-between items-center mb-2">
          <h3 class="font-extrabold text-sm text-slate-800 dark:text-white" data-i18n="requestTitle">📝 வாடிக்கையாளர் கேட்ட பொருட்கள்</h3>
          <button onclick="startVoiceSearch('request')" class="text-xs bg-leaf/20 text-leaf font-bold px-2 py-1 rounded-lg flex items-center gap-1">
            🎙️ பேசு
          </button>
        </div>
        <div class="flex gap-2 mb-2">
          <input type="text" id="request-input" placeholder="எ.கா: ஹார்லிக்ஸ் பாக்கெட்..." class="flex-1 text-xs p-2 border rounded-xl dark:bg-slate-700 dark:border-slate-600" />
          <button onclick="addCustomerRequest()" class="bg-leaf text-white px-3 py-2 rounded-xl text-xs font-bold">சேர்</button>
        </div>
        <div id="request-items-list" class="space-y-1 text-xs max-h-32 overflow-y-auto">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- UPI & App Settings -->
      <div class="bg-white dark:bg-slate-800 p-4 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700 space-y-3">
        <h3 class="font-extrabold text-sm text-slate-800 dark:text-white" data-i18n="settingsTitle">⚙️ அமைப்புகள் (Settings)</h3>
        
        <!-- UPI ID Setting -->
        <div class="space-y-1 text-xs">
          <label class="font-bold text-slate-600 dark:text-slate-300">UPI ID (ஜிபே / போன்பே):</label>
          <div class="flex gap-2">
            <input type="text" id="setting-upi-id" placeholder="e.g. 9842771765@upi" class="flex-1 p-2 border rounded-xl dark:bg-slate-700 dark:border-slate-600" />
            <button onclick="saveUpiSettings()" class="bg-tea text-white px-3 py-1.5 rounded-xl font-bold">Save</button>
          </div>
        </div>

        <!-- Voice Reply On/Off Switch -->
        <div class="flex items-center justify-between border-t dark:border-slate-700 pt-2 text-xs">
          <span class="font-bold text-slate-700 dark:text-slate-300" data-i18n="voiceToggle">குரல் பதில் (Voice Output):</span>
          <input type="checkbox" id="setting-voice-toggle" onchange="toggleVoiceOutput(this.checked)" class="w-5 h-5 accent-leaf" />
        </div>
      </div>

      <!-- Shop Info & Contacts -->
      <div class="bg-tea-light/30 dark:bg-slate-800/60 p-4 rounded-3xl text-center text-xs space-y-2 border border-tea-light/40">
        <p class="font-extrabold text-tea-dark dark:text-tea-light">Saravanan Professional Grocery Store</p>
        <p class="text-slate-500">Maintained by: SARAVANAN S P</p>
        <div class="flex justify-center gap-3 font-bold">
          <a href="tel:9842771765" target="_blank" onclick="handleCallClick('9842771765')" class="text-leaf underline">📞 9842771765</a>
          <a href="tel:6380904140" target="_blank" onclick="handleCallClick('6380904140')" class="text-leaf underline">📞 6380904140</a>
        </div>
      </div>
    </section>

